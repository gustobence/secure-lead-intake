        "query": "\nWITH inserted AS (\n  INSERT INTO lead_requests (\n    customer_name,\n    customer_email,\n    request_details,\n    dedupe_key\n  )\n  VALUES ($1, $2, $3, $4)\n  ON CONFLICT (dedupe_key) DO NOTHING\n  RETURNING id\n)\nSELECT\n  EXISTS (SELECT 1 FROM inserted) AS was_inserted,\n  (SELECT id FROM inserted) AS lead_id;\n",
        "options": {
          "queryReplacement": "=\n{{ [\n  $json.customer_name,\n  $json.customer_email,\n  $json.request_details,\n  JSON.stringify([\n    String($json.customer_email ?? \"\").trim().toLowerCase(),\n    String($json.request_details ?? \"\").trim()\n  ])\n] }}\n"
        }
