    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const data = item.json;\n\n  const name = String(data.customer_name ?? \"\").trim();\n  const email = String(data.customer_email ?? \"\").trim();\n  const message = String(data.request_details ?? \"\").trim();\n\n  const errors = [];\n\n  if (name.length < 2 || name.length > 100) {\n    errors.push(\"Hibas nev\");\n  }\n\n  if (\n    email.length > 254 ||\n    !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)\n  ) {\n    errors.push(\"Hibas email\");\n  }\n\n  if (message.length < 10 || message.length > 2000) {\n    errors.push(\"Hibas uzenethossz\");\n  }\n\n  return {\n    json: {\n      customer_name: name,\n      customer_email: email,\n      request_details: message,\n      is_valid: errors.length === 0,\n      errors: errors\n    }\n  };\n});\n"
      },
