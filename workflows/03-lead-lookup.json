      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  customer_name,\n  customer_email,\n  request_details,\n  status,\n  notification_status,\n  created_at\nFROM public.lead_requests\nWHERE\n  (\n    COALESCE($1::text, '') = ''\n    OR status = $1::text\n  )\n  AND\n  (\n    COALESCE($2::text, '') = ''\n    OR customer_name ILIKE '%' || $2::text || '%'\n    OR customer_email ILIKE '%' || $2::text || '%'\n    OR request_details ILIKE '%' || $2::text || '%'\n  )\nORDER BY created_at DESC, id DESC\nLIMIT 20;",
        "options": {
          "queryReplacement": "={{ [   String($json.status ?? \"\").trim(),   String($json.keyword ?? \"\").trim() ] }}"
        }
