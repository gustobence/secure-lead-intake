      "name": "Van értesítési hiba?"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=⚠️ Secure Lead Intake – Hibariasztás\n\nA rendszer értesítési problémát talált.\n\nProblémás rekordok száma: {{ $json.problem_count }}\n\nEllenőrizd a Notification Monitor workflow-t és a PostgreSQL-adatbázist.",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        640,
        -144
      ],
      "id": "32dbcc70-f29a-430b-b221-c854c6e83367",
      "name": "Discord",
      "credentials": {
        "discordWebhookApi": {
          "id": "REDACTED",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n  COUNT(*)::integer AS problem_count,\n  COALESCE(\n    json_agg(id ORDER BY id),\n    '[]'::json\n  ) AS alert_ids\nFROM lead_requests\nWHERE alert_sent_at IS NULL\n  AND (\n    notification_status = 'failed'\n    OR (\n      notification_status = 'pending'\n      AND created_at < NOW() - INTERVAL '15 minutes'\n    )\n  );\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        224,
        0
      ],
      "id": "a698a1ff-ae51-4dad-927e-219c96cee3ba",
      "name": "Find unalerted alerts",
      "credentials": {
        "postgres": {
          "id": "REDACTED",
          "name": "Neon – Secure Lead App"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH alert_ids AS (\n  SELECT jsonb_array_elements_text($1::jsonb)::bigint AS id\n),\nupdated AS (\n  UPDATE lead_requests AS l\n  SET alert_sent_at = NOW()\n  FROM alert_ids\n  WHERE l.id = alert_ids.id\n    AND l.alert_sent_at IS NULL\n    AND (\n      l.notification_status = 'failed'\n      OR (\n        l.notification_status = 'pending'\n        AND l.created_at < NOW() - INTERVAL '15 minutes'\n      )\n    )\n  RETURNING l.id\n)\nSELECT COUNT(*)::integer AS marked_count\nFROM updated;\n",
        "options": {
          "queryReplacement": "={{ JSON.stringify($('Find unalerted alerts').first().json.alert_ids) }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        864,
        -144
      ],
      "id": "49c3ed4f-e760-4175-bdca-c8a34054587a",
      "name": "Mark alerts sent",
